# Environment variables — AQ Enterprises (aq-nextjs)
# Copy to `.env.local` for local development. Never commit real secrets.

# ── Lead email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Where lead notifications are delivered. Should match the official email in src/lib/business.ts once confirmed.
# Defaults to SMTP_USER if empty. Do not invent an info@ address.
LEAD_DESTINATION_EMAIL=

# ── Analytics (optional) ───────────────────────────────────────────
# GA4 Measurement ID only — never put API secrets in NEXT_PUBLIC_* vars.
# Leave empty until Google Analytics is created; site works without it.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Neon database and owner dashboard ─────────────────────────────
# Use Neon's pooled PostgreSQL connection string, including sslmode=require.
DATABASE_URL=
# Optional direct connection override for schema setup; keep runtime DATABASE_URL pooled.
# For Neon, setup otherwise derives the direct hostname from the pooled URL.
DATABASE_URL_UNPOOLED=
# Owner login email. Never prefix credentials with NEXT_PUBLIC_.
ADMIN_EMAIL=
# Generate with npm run admin:password; stores a salted scrypt hash, not a password.
ADMIN_PASSWORD_HASH=
